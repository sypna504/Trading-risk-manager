# backend
ML_SERVICE_ADDRESS=ml_service:50051
ML_SERVICE_PORT=50051
MIN_CANDLES=60
DATABASE_PATH=/app/data/trading_risk.db
LOG_LEVEL=INFO
REQUEST_TIMEOUT=15
MODELS_ROOT=/app/app/ml_services/app/models
MODEL_REGISTRY_PATH=/app/app/ml_services/app/models/registry.json
MODEL_PATH=/app/app/ml_services/app/models/risk_model_v2_online.cbm
MODEL_CONFIG_PATH=/app/app/ml_services/app/models/risk_model_v2_online_config.json
MODEL_MAX_AGE_DAYS=30
MODEL_BLOCK_TRADES_WHEN_STALE=false
MODEL_REQUIRE_VALIDATED_STATUS=false

# risk engine
ATR_STOP_MULTIPLIER=1.5
MIN_STOP_LOSS_PCT=0.5
RISK_REWARD_RATIO=2.0

# decision outcome tracking
OUTCOME_TARGET_HORIZON_BARS=3
OUTCOME_TARGET_HORIZON_MINUTES=180
OUTCOME_FEE=0.001
OUTCOME_SLIPPAGE=0.0005
OUTCOME_MIN_NET_RETURN=0.002
OUTCOME_MAX_DRAWDOWN=-0.015
OUTCOME_AUTO_EVALUATION=true
OUTCOME_CHECK_INTERVAL_SECONDS=300
OUTCOME_BATCH_SIZE=100
OUTCOME_MAX_RETRIES=5

# ML inference
ML_MODELS_ROOT=/app/app/models
ML_REGISTRY_PATH=/app/app/models/registry.json
ML_MODEL_PATH=/app/app/models/risk_model_v2_online.cbm
ML_MODEL_CONFIG_PATH=/app/app/models/risk_model_v2_online_config.json

# model readiness policy
MODEL_BLOCK_TRADES_WHEN_STALE=false
MODEL_REQUIRE_VALIDATED_STATUS=false

# optional Telegram news source - keep real values only in local .env
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=/app/data/telegram.session

# optional local news LLM
# use NEWS_LLM_PROVIDER=ollama to enable; keep model empty to stay on rule fallback
NEWS_LLM_PROVIDER=rule_based
NEWS_LLM_URL=http://ollama:11434
NEWS_LLM_MODEL=
NEWS_LLM_TIMEOUT_SECONDS=8

# informational news context in trading API
NEWS_CONTEXT_ENABLED=true
