FROM python:3.11-slim

WORKDIR /app

COPY app/backend/api/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Always regenerate the protobuf package after COPY. This prevents stale local
# generated files from shadowing the current contract in either container.
RUN rm -rf ./ml && mkdir -p ./ml/v1 && \
    python -m grpc_tools.protoc \
      -I./app/proto \
      --python_out=. \
      --grpc_python_out=. \
      ./app/proto/ml/v1/ml.proto && \
    python ./scripts/verify_backend_runtime.py

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

CMD ["uvicorn", "app.backend.api.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
