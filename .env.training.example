ML_EXCHANGE=binance
ML_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,USDCUSDT,XRPUSDT,SOLUSDT,ADAUSDT,DOGEUSDT,TRXUSDT,AVAXUSDT,DOTUSDT,LINKUSDT,TONUSDT,SHIBUSDT,LTCUSDT,BCHUSDT,UNIUSDT,ICPUSDT,NEARUSDT,APTUSDT,FILUSDT,XLMUSDT,OPUSDT,SUIUSDT,ATOMUSDT,AAVEUSDT,ALGOUSDT,FETUSDT,VETUSDT,EGLDUSDT,GALAUSDT,SANDUSDT,MANAUSDT,PEPEUSDT,CHZUSDT,FLOWUSDT,GRTUSDT,IMXUSDT,LDOUSDT,MINAUSDT,QNTUSDT,RENDERUSDT,STXUSDT,THETAUSDT,TIAUSDT
ML_INTERVAL=1h
ML_SUPPORTED_INTERVALS=1h
ML_SUPPORTED_STRATEGIES=breakout,mean_reversion
ML_FEATURE_SCHEMA_VERSION=v3

# target / execution contract
ML_TARGET_DEFINITION=first_touch_atr_rr
ML_TARGET_HORIZON_MINUTES=180
ML_TARGET_HORIZON=3
ML_MINIMUM_NET_RETURN=0.002
ML_MAXIMUM_TARGET_DRAWDOWN=-0.015
ML_FEE=0.001
ML_SLIPPAGE=0.0005
ML_RISK_ATR_STOP_MULTIPLIER=1.5
ML_RISK_MIN_STOP_LOSS_PCT=0.5
ML_RISK_REWARD_RATIO=2.0
ML_INTRABAR_PRIORITY=stop_loss

# temporal validation
TRAINING_WINDOW_DAYS=365
ML_TRAINING_WINDOW_CANDIDATES=180,365,540
ML_AUTO_SELECT_TRAINING_WINDOW=false
ML_TRAIN_RATIO=0.70
ML_VALIDATION_RATIO=0.15
ML_TEST_RATIO=0.15
ML_EMBARGO_MINUTES=60
ML_WALK_FORWARD_FOLDS=4
ML_MINIMUM_FOLD_ROWS=200

# dataset / quality gates
ML_MINIMUM_DATASET_ROWS=1000
ML_MINIMUM_CLASS_ROWS=100
ML_MINIMUM_SELECTED_TRADES=50
ML_MINIMUM_STRATEGY_SELECTED_TRADES=15
ML_MINIMUM_UNIQUE_PROBABILITIES=50
ML_MINIMUM_PROBABILITY_STD=0.01
ML_MINIMUM_PROBABILITY_RANGE=0.05
ML_MINIMUM_PROFIT_FACTOR=1.0
ML_MAXIMUM_ALLOWED_DRAWDOWN=-0.35
ML_MINIMUM_WALK_FORWARD_POSITIVE_RATE=0.50
ML_MINIMUM_COMPLETED_WALK_FORWARD_FOLDS=2
ML_MAXIMUM_SYMBOL_TRADE_SHARE=0.50
ML_MAXIMUM_STRATEGY_TRADE_SHARE=0.90
ML_MAXIMUM_REGIME_TRADE_SHARE=0.85
ML_MAXIMUM_MONTH_TRADE_SHARE=0.85
ML_MINIMUM_TEST_MONTHS=2

# portfolio backtest / uncertainty
ML_BACKTEST_STARTING_CAPITAL=10000
ML_BACKTEST_RISK_PER_TRADE_PCT=1
ML_BACKTEST_MAX_POSITION_SHARE_PCT=25
ML_BACKTEST_MAX_CONCURRENT_POSITIONS=5
ML_BACKTEST_MAX_PORTFOLIO_RISK_PCT=5
ML_BACKTEST_MAX_GROSS_EXPOSURE_PCT=100
ML_MINIMUM_PORTFOLIO_IMPROVEMENT=0
ML_BOOTSTRAP_ITERATIONS=100
ML_BOOTSTRAP_BLOCK_SIZE=24

# calibration / model search
ML_MODEL_SEEDS=42,137
ML_EARLY_STOPPING_ROUNDS=120
ML_ENABLE_CALIBRATION=true
ML_CALIBRATION_METHODS=none,platt,isotonic
ML_MINIMUM_CALIBRATION_BRIER_IMPROVEMENT=0.001
ML_MINIMUM_CALIBRATED_STD_RATIO=0.35

# history / retraining guards
ML_HISTORY_SYMBOL_POLICY=extend
ML_REQUEST_LIMIT=1000
ML_REQUEST_TIMEOUT=20
ML_MINIMUM_HISTORY_ROWS=500
MIN_NEW_UNIQUE_TIMESTAMPS_FOR_RETRAIN=24
MIN_HOURS_BETWEEN_RETRAINS=20
ML_MINIMUM_SYMBOL_COVERAGE=0.95
ML_REQUIRED_SYMBOLS=BTCUSDT,ETHUSDT
FORCE_RETRAIN=false
RETRAIN_ON_DATA_CHANGE_ONLY=true

# promotion / runtime
ML_DEPLOY_AFTER_TRAINING=true
ML_CANDIDATE_ONLY=false
ML_ALLOW_LEGACY_BOOTSTRAP=false
ML_ALLOW_SCHEMA_MIGRATION=false
ML_RESTART_SERVICE_AFTER_PROMOTION=false
ML_MODELS_ROOT=app/ml_services/app/models
ML_REGISTRY_PATH=app/ml_services/app/models/registry.json
ML_HISTORY_PATH=app/ml_services/app/training/data/history_data.parquet
ML_DATASET_PATH=app/ml_services/app/training/data/ml_dataset_v3.parquet
